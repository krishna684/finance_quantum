# TikTok Research API credentials (legacy — being phased out)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional: existing token if you manage auth outside this pipeline
TIKTOK_ACCESS_TOKEN=

# SQLite output database (legacy Research API pipeline)
DB_PATH=data/tiktok_signals.db

# Collection controls (shared between pipelines)
QUERY_VIDEOS_TARGET=75
RANDOM_LOW_ENGAGEMENT_TARGET=25
COMMENTS_PER_VIDEO_TARGET=100
COMMENT_SCAN_LIMIT=300
WINDOW_DAYS=30
LOOKBACK_MONTHS=24
REGION_CODES=US
LOG_LEVEL=INFO

# -----------------------------------------------------------------------
# Financial TikTok Collection (Bright Data architecture)
# -----------------------------------------------------------------------

# Bright Data Dataset API key (required for real collection)
BRIGHTDATA_API_KEY=

# OpenAI API key (required for Whisper transcription)
OPENAI_API_KEY=

# Anthropic API key (required for Pass 2 + entity extraction + content classification)
ANTHROPIC_API_KEY=

# Optional: path to custom ticker universe JSON (same schema as keywords_finance.json)
# TICKER_UNIVERSE_PATH=data/my_ticker_universe.json

# Video frame sampling rate in seconds (1 frame every N seconds, default 2)
FRAME_SAMPLE_RATE=2

# Parallel workers for yt-dlp + Whisper downloads
TRANSCRIPTION_WORKERS=4

# Anthropic model for LLM classification stages
FIN_LLM_MODEL=claude-haiku-4-5-20251001

# Output database for financial TikTok collection (default: data/tiktok_fin.db)
# FIN_DB_PATH=data/tiktok_fin.db

# -----------------------------------------------------------------------
# Quantum Pipeline (PennyLane; section 2.3 of proposal)
# -----------------------------------------------------------------------

# Number of qubits = PCA output features (proposal range 8-20; default 8)
# QUANTUM_N_QUBITS=8

# Feature map: "angle" (entangling rotation layers) or "amplitude" (statevector)
# QUANTUM_FEATURE_MAP=angle

# Number of encoding + entanglement repetitions (more = richer kernel, more depth)
# QUANTUM_FEATURE_MAP_REPS=2

# Hard cap on training-set size for O(n^2) kernel estimation
# QUANTUM_MAX_TRAIN_SAMPLES=400

# VQC ansatz depth (StronglyEntanglingLayers)
# QUANTUM_VQC_LAYERS=3

# VQC training epochs
# QUANTUM_VQC_EPOCHS=60

# VQC Adam learning rate
# QUANTUM_VQC_LEARNING_RATE=0.05

# VQC minibatch size
# QUANTUM_VQC_BATCH_SIZE=32

# Quantum kernel SVM regularisation
# QUANTUM_SVM_C=1.0

# RNG seed for subsampling, weight init, and shuffling
# QUANTUM_SEED=42

# Shot count: unset (default) = exact analytic simulation; set int for hardware-noise emulation
# QUANTUM_SHOTS=1024
