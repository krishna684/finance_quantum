# TikTok Research API credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional: existing token if you manage auth outside this pipeline
TIKTOK_ACCESS_TOKEN=

# SQLite output database
DB_PATH=data/tiktok_signals.db

# Collection controls
QUERY_VIDEOS_TARGET=75
RANDOM_LOW_ENGAGEMENT_TARGET=25
COMMENTS_PER_VIDEO_TARGET=100
COMMENT_SCAN_LIMIT=300
WINDOW_DAYS=30
LOOKBACK_MONTHS=24
REGION_CODES=US
